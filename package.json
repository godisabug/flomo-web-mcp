{
  "name": "flomo-web-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "Self-hosted flomo MCP server based on flomo web session credentials.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "flomo",
    "typescript",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godisabug/flomo-web-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/godisabug/flomo-web-mcp/issues"
  },
  "homepage": "https://github.com/godisabug/flomo-web-mcp#readme",
  "bin": {
    "flomo-web-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "prepack": "npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=moderate",
    "prepublishOnly": "npm run audit:prod",
    "verify": "npm run typecheck && npm run typecheck:test && npm test && npm run build && npm run smoke:stdio"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
